# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Postgres --------------------------------------------------------------
# Owner connection. Runs migrations and the seed scripts.
DATABASE_URL=postgresql://finance_owner:PASSWORD@postgres:5432/finance

# Optional least-privilege connections. Both fall back to DATABASE_URL when
# unset, which is fine locally. In Coolify, set them: finance_web cannot touch
# the ledger and finance_sync cannot touch rules or overrides.
# See db/migrations/0004_roles_and_grants.sql for how to grant them login.
DATABASE_URL_WEB=
DATABASE_URL_SYNC=

# TLS is off unless set. Leave empty when Postgres shares a private network with
# the app (the normal Coolify setup). Set to "require" whenever the connection
# leaves the host, or "no-verify" for a managed database with a self-signed
# certificate.
PGSSLMODE=

# --- Sign-in ----------------------------------------------------------------
# The one shared password for the household, and the whole of the auth config.
# Set it and every route is gated. Leave it unset and the app is open, which is
# what you want locally against a throwaway database.
#
# It is also the key the session cookie is signed with, so there is no second
# secret to set — and changing it signs every device out.
APP_PASSWORD=

# Only needed when one deployment answers on several hostnames and passkeys
# registered on one should work on the others: set it to the shared parent
# domain. Otherwise the relying party is derived from the request host, which is
# what makes localhost, a LAN address and the real domain all work unconfigured.
WEBAUTHN_RP_ID=

# --- Akahu -----------------------------------------------------------------
# Personal App credentials from my.akahu.io.
# Sent as: Authorization: Bearer <AKAHU_USER_TOKEN>
AKAHU_USER_TOKEN=
# Sent as: X-Akahu-Id: <AKAHU_APP_ID_TOKEN>
AKAHU_APP_ID_TOKEN=
